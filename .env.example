PORT=3001
FRONTEND_ORIGIN=http://localhost:3000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Transcripcion de notas de voz entrantes
OPENAI_TRANSCRIBE_MODEL=whisper-1

SUNO_API_KEY=
SUNO_BASE_URL=https://api.sunoapi.org/api/v1
SUNO_MODEL=V4_5ALL
PUBLIC_BACKEND_URL=https://tu-backend.onrender.com

FIREBASE_STORAGE_BUCKET=cantalab-crm.firebasestorage.app
# Usa una de estas opciones:
FIREBASE_SERVICE_ACCOUNT_PATH=/etc/secrets/serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_BASE64=

WATERMARK_URL=https://cantalab.com/wp-content/uploads/2025/05/marca-de-agua-1-minuto.mp3
CLIP_DURATION_SECONDS=60

# Proveedor de WhatsApp: baileys (default) | kanwap | vev
WHATSAPP_PROVIDER=baileys
# La sesion se guarda en Firestore (coleccion whatsappSessions): sobrevive deploys sin disco.
BAILEYS_SESSION_ID=cantalab

# KanWap API para envio por WhatsApp
KANWAP_API_URL=https://kanwap.udelonline.com
KANWAP_API_KEY=
KANWAP_SESION_ID=

# Fallback opcional si despues quieres cambiar de proveedor sin tocar el flujo.
# DELIVERY_API_URL=
# DELIVERY_API_TOKEN=

# Espera a que el contacto termine de escribir antes de responder, para
# agrupar los mensajes en rafaga y no contestar con contexto a medias.
INBOUND_DEBOUNCE_MS=8000
INBOUND_BUFFER_MAX_WAIT_MS=45000
INBOUND_BUFFER_MAX_MESSAGES=8

# Cron interno de Render. En produccion puede quedarse true.
ENABLE_CRON=true
JOB_SECRET=
